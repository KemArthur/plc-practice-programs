PROGRAM AssignmentOne
  VAR
    Pump_Start_PB : BOOL AT %IX0.0; (* Pump start button, TRUE when pressed. *)
    Pump_Stop_PB : BOOL AT %IX0.1; (* Pump stop button, TRUE when pressed. *)
    Fan_Start_PB : BOOL AT %IX0.2; (* Fan start button, TRUE when pressed. *)
    Fan_Stop_PB : BOOL AT %IX0.3; (* Fan stop button, TRUE when pressed. *)
    Cooling_Tower_Fan_Run : BOOL; (* Fan run command. Latched by Fan_Start_PB, needs the pump running, dropped by Fan_Stop_PB. Internal, no wire. *)
    Chilled_Water_Pump : BOOL AT %QX0.0; (* Output to the chilled water pump contactor. *)
    Cooling_Tower_Fan : BOOL AT %QX0.1; (* Output to the cooling tower fan contactor. *)
    Chilled_Water_Pump_Run : BOOL; (* Pump run command. Latched by Pump_Start_PB, dropped by Pump_Stop_PB. Internal, no wire. *)
  END_VAR

