PROGRAM AssignmentTwo
  VAR
    Start_PB : BOOL AT %IX1.0; (* Pump start button, TRUE when pressed. *)
    Stop_PB : BOOL AT %IX1.1; (* Pump stop button, TRUE when pressed. *)
    Overload_Trip : BOOL AT %IX1.2; (* Overload trip, when TRUE stops the main (duty) fuel pump. *)
    Duty_Fuel_Pump : BOOL AT %QX1.0; (* Output to the main (duty) fuel pump contactor. *)
    Backup_Fuel_Pump : BOOL AT %QX1.1; (* Output to the backup fuel pump contactor. *)
    System_Run : BOOL; (* Fuel demand, latched by Start_PB, dropped by Stop_PB. *)
  END_VAR

