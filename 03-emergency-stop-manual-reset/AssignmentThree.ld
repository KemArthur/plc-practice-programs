PROGRAM AssignmentThree
  VAR
    Start_PB : BOOL AT %IX2.0; (* Start button, TRUE when pressed. *)
    Stop_PB : BOOL AT %IX2.1; (* Stop button, TRUE when pressed. *)
    E_Stop_PB : BOOL AT %IX2.2; (* Emergency stop button, TRUE when pressed, requiring a physical reset. *)
    System_Run : BOOL; (* Fan run command, latched by Start_PB, dropped by Stop_PB OR E_Stop_PB. *)
    Vent_Fan : BOOL AT %QX2.0; (* Output to vent fan contactor. *)
  END_VAR

