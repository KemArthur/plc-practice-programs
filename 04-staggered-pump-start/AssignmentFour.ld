PROGRAM AssignmentFour
  VAR
    Master_Start_PB : BOOL AT %IX3.0; (* Start button, TRUE when pressed. *)
    Master_Stop_PB : BOOL AT %IX3.1; (* Stop button, TRUE when pressed. *)
    System_Run : BOOL; (* Run command for both cooling pumps. Latched on by Master_Start_PB, dropped by Master_Stop_PB. *)
    Cooling_Pump_A : BOOL AT %QX3.0; (* Output to cooling pump A contactor. Runs as soon as System_Run is on. *)
    Cooling_Pump_B : BOOL AT %QX3.1; (* Output to cooling pump B contactor. Runs 5 s after System_Run, via Pump_B_Delay. *)
    Pump_B_Delay : TON; (* 5 second start delay for pump B. Times while System_Run is on, resets when it drops. *)
  END_VAR

