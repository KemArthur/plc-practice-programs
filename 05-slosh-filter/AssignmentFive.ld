PROGRAM AssignmentFive
  VAR
    High_Level_Float : BOOL AT %IX4.0; (* High-level float switch. TRUE when liquid is at the high level. *)
    Discharge_Pump : BOOL AT %QX4.0; (* Output to discharge pump contactor. TRUE runs the pump. Comes on once the float has been made continuously for 4 seconds (via Slosh_Filter), off as soon as the float drops. *)
    Slosh_Filter : TON; (* 4 second slosh filter. Pump starts only after the float has been made for 4 seconds in a row. Resets when the float drops. *)
  END_VAR

