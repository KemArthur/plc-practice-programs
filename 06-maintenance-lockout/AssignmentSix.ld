PROGRAM AssignmentSix
  VAR
    Start_PB : BOOL AT %IX5.0; (* Start button, TRUE when pressed. *)
    Stop_PB : BOOL AT %IX5.1; (* Stop button, TRUE when pressed. *)
    Alarm_Reset_PB : BOOL AT %IX5.2; (* Alarm reset button, TRUE when pressed. *)
    Fuel_Pump : BOOL AT %QX5.0; (* Output to fuel transfer pump contactor. TRUE runs the pump. Latched on by Start_PB, dropped by Stop_PB. A new start is blocked while Maintenance_Alarm is on. *)
    Maintenance_Alarm : BOOL AT %QX5.1; (* Maintenance alarm lamp. TRUE lights the lamp. Comes on once the fuel pump has started 5 times (Pump_Start_Counter reaches 5), off when Alarm_Reset_PB clears the count. While on, it blocks new pump starts. *)
    Pump_Start_Counter : CTU; (* Counts fuel pump starts (each off-to-on). Q goes TRUE at 5, raising Maintenance_Alarm. Cleared to 0 by Alarm_Reset_PB. *)
  END_VAR

